# Core
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public origin used for canonical URLs, sitemap, and review links.
# Set this to the custom domain when it is attached. Falls back to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (optional; deterministic demo responses are used when omitted)
GROQ_API_KEY=gsk_replace_me

# Stripe Billing
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_ID_PRO=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Vercel storage (optional)
KV_REST_API_URL=https://replace-me.kv.vercel-storage.com
KV_REST_API_TOKEN=replace_me
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Email via Resend (optional)
# TODO: Set EMAIL_FROM to a verified sender on a domain you own once mail is configured.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=ReputationFlow <reviews@example.com>

# ReputationFlow does not send SMS. Do not add a texting provider for review requests.

# Ads tags. Leave blank to skip that tag. NEXT_PUBLIC_ values are inlined at build time, so change them and redeploy.
# Google Ads ID is the AW- account id. Labels are the conversion action labels, not the full send_to string.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
